DATABASE_URL=postgresql://...
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
DISCORD_CLIENT_SECRET=your-client-secret-here
OAUTH2_REDIRECT_URI=http://localhost:3001/oauth2/callback
OAUTH2_PORT=3001

# 32-byte key for encrypting stored CHUNITHM tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Set to any non-empty value to enable verbose [debug] logging (profile fetch diagnostics)
DEBUG="..."

# What game this bot operates for.
# maimai, chunithm
GAME=chunithm
